#include <stdio.h>
#include <stdlib.h>

int twoStacks(int maxSum, int a_count, int* a, int b_count, int* b) {
    int count_a = 0;
    long long sum = 0;

    while (count_a < a_count && sum + a[count_a] <= maxSum) {
        sum += a[count_a];
        count_a++;
    }

    int max_score = count_a;
    int count_b = 0;

    while (count_b < b_count) {
        sum += b[count_b];
        count_b++;

        while (sum > maxSum && count_a > 0) {
            count_a--;
            sum -= a[count_a];
        }

        if (sum <= maxSum) {
            int current_score = count_a + count_b;
            if (current_score > max_score) {
                max_score = current_score;
            }
        } else {
            break;
        }
    }

    return max_score;
}

int main() {
    int g;
    if (scanf("%d", &g) != 1) return 0;

    while (g--) {
        int n, m, maxSum;
        if (scanf("%d %d %d", &n, &m, &maxSum) != 3) break;

        int* a = (int*)malloc(n * sizeof(int));
        for (int i = 0; i < n; i++) {
            if (scanf("%d", &a[i]) != 1) break;
        }

        int* b = (int*)malloc(m * sizeof(int));
        for (int i = 0; i < m; i++) {
            if (scanf("%d", &b[i]) != 1) break;
        }

        int result = twoStacks(maxSum, n, a, m, b);
        printf("%d\n", result);

        free(a);
        free(b);
    }

    return 0;
}
