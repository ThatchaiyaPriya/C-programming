#include <stdio.h>
void inorder(struct TreeNode* node, struct TreeNode** current) {
    if (node == NULL) {
        return;
    }
    inorder(node->left, current);
    node->left = NULL;
    (*current)->right = node;
    *current = node; 
    inorder(node->right, current);
}
struct TreeNode* increasingBST(struct TreeNode* root) {
    struct TreeNode dummy;
    dummy.left = NULL;
    dummy.right = NULL;
    struct TreeNode* current = &dummy;
    inorder(root, &current);
    current->right = NULL;
    return dummy.right;
}
