#include <stdio.h>
#include <stdlib.h>

long largestRectangle(int h_count, int* h) {
    int* stack = (int*)malloc((h_count + 1) * sizeof(int));
    int top = -1;
    long max_area = 0;
    int i = 0;

    while (i < h_count) {
        if (top == -1 || h[stack[top]] <= h[i]) {
            stack[++top] = i++;
        } else {
            int tp = stack[top--];
            long height = h[tp];
            long width = (top == -1) ? i : (i - stack[top] - 1);
            long area = height * width;
            if (area > max_area) {
                max_area = area;
            }
        }
    }

    while (top != -1) {
        int tp = stack[top--];
        long height = h[tp];
        long width = (top == -1) ? i : (i - stack[top] - 1);
        long area = height * width;
        if (area > max_area) {
            max_area = area;
        }
    }

    free(stack);
    return max_area;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* h = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &h[i]) != 1) break;
    }

    long result = largestRectangle(n, h);
    printf("%ld\n", result);

    free(h);
    return 0;
}
