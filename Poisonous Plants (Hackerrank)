// Define the missing structure for tracking elements in the monotonic stack
typedef struct {
    int value;
    int days;
} StackElement;

/*
 * Complete the 'poisonousPlants' function below.
 *
 * The function is expected to return an INTEGER.
 * The function accepts INTEGER_ARRAY p as parameter.
 */
int poisonousPlants(int p_count, int* p) {
    if (p_count <= 1) return 0;

    // Dynamically allocate the stack array
    StackElement* stack = (StackElement*)malloc(p_count * sizeof(StackElement));
    int top = -1;
    int max_days = 0;

    for (int i = 0; i < p_count; i++) {
        int current_days = 0;

        // Pop elements from the stack that are greater than or equal to the current plant
        while (top >= 0 && stack[top].value >= p[i]) {
            if (stack[top].days > current_days) {
                current_days = stack[top].days;
            }
            top--;
        }

        // If the stack is empty after popping, this plant has the minimum 
        // pesticide seen so far from the left, so it will never die.
        if (top == -1) {
            current_days = 0;
        } else {
            // Otherwise, it dies 1 day after the maximum days of the intermediate popped elements
            current_days += 1;
        }

        // Keep track of the overall maximum days needed for the garden to stabilize
        if (current_days > max_days) {
            max_days = current_days;
        }

        // Push current element onto our monotonic tracking stack
        top++;
        stack[top].value = p[i];
        stack[top].days = current_days;
    }

    free(stack);
    return max_days;
}

int main()
{
    FILE* fptr = fopen(getenv("OUTPUT_PATH"), "w");
    if (!fptr) {
        fptr = stdout;
    }

    int n = parse_int(ltrim(rtrim(readline())));

    char** p_temp = split_string(rtrim(readline()));

    int* p = malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        int p_item = parse_int(*(p_temp + i));
        *(p + i) = p_item;
    }

    int result = poisonousPlants(n, p);

    fprintf(fptr, "%d\n", result);

    fclose(fptr);
    free(p);
    free(p_temp);

    return 0;
}

char* readline() {
    size_t alloc_length = 1024;
    size_t data_length = 0;

    char* data = malloc(alloc_length);

    while (true) {
        char* cursor = data + data_length;
        char* line = fgets(cursor, alloc_length - data_length, stdin);

        if (!line) {
            break;
        }

        data_length += strlen(cursor);

        if (data_length < alloc_length - 1 || data[data_length - 1] == '\n') {
            break;
        }

        alloc_length <<= 1;
        data = realloc(data, alloc_length);

        if (!data) {
            return NULL;
        }
    }

    if (data_length == 0) {
        free(data);
        return NULL;
    }

    if (data[data_length - 1] == '\n') {
        data[data_length - 1] = '\0';
    } else {
        data = realloc(data, data_length + 1);
        data[data_length] = '\0';
    }

    return data;
}

char* ltrim(char* str) {
    if (!str || !*str) {
        return str;
    }

    while (*str != '\0' && isspace(*str)) {
        str++;
    }

    return str;
}

char* rtrim(char* str) {
    if (!str || !*str) {
        return str;
    }

    char* end = str + strlen(str) - 1;

    while (end >= str && isspace(*end)) {
        end--;
    }

    *(end + 1) = '\0';

    return str;
}

char** split_string(char* str) {
    char** splits = NULL;
    char* token = strtok(str, " ");
    int spaces = 0;

    while (token) {
        splits = realloc(splits, sizeof(char*) * ++spaces);

        if (!splits) {
            return NULL;
        }

        splits[spaces - 1] = token;
        token = strtok(NULL, " ");
    }

    return splits;
}

int parse_int(char* str) {
    char* endptr;
    int value = strtol(str, &endptr, 10);

    if (endptr == str || *endptr != '\0') {
        exit(EXIT_FAILURE);
    }

    return value;
}
