int compareChars(const void* a, const void* b) {
    return (*(char*)a - *(char*)b);
}
int compareStrings(const void* a, const void* b) {
    return strcmp(*(const char**)a, *(const char**)b);
}
int sherlockAndAnagrams(char* s) {
    int n = strlen(s);
    int total_substrings = (n * (n + 1)) / 2;
    
    // Allocate memory to hold all possible substrings
    char** substrings = (char**)malloc(total_substrings * sizeof(char*));
    int sub_idx = 0;
    
    // 1. Generate all possible substrings, and sort characters of each substring
    for (int len = 1; len <= n; len++) {
        for (int i = 0; i <= n - len; i++) {
            substrings[sub_idx] = (char*)malloc((len + 1) * sizeof(char));
            
            // Extract substring of length 'len' starting at index 'i'
            strncpy(substrings[sub_idx], &s[i], len);
            substrings[sub_idx][len] = '\0';
            
            // Sort characters inside the substring so anagrams match exactly
            qsort(substrings[sub_idx], len, sizeof(char), compareChars);
            sub_idx++;
        }
    }
    
    // 2. Sort the array of all substring signatures to group identical ones together
    qsort(substrings, total_substrings, sizeof(char*), compareStrings);
    
    int total_pairs = 0;
    int i = 0;
    
    // 3. Count identical grouped signatures using combination count: (count * (count - 1)) / 2
    while (i < total_substrings) {
        int count = 1;
        while (i + 1 < total_substrings && strcmp(substrings[i], substrings[i + 1]) == 0) {
            count++;
            i++;
        }
        
        if (count > 1) {
            total_pairs += (count * (count - 1)) / 2;
        }
        i++;
    }
    
    // Free allocated memory
    for (int j = 0; j < total_substrings; j++) {
        free(substrings[j]);
    }
    free(substrings);
    
    return total_pairs;
}
int main()
{
    FILE* fptr = fopen(getenv("OUTPUT_PATH"), "w");
    int q = parse_int(ltrim(rtrim(readline())));
    for (int q_itr = 0; q_itr < q; q_itr++) {
        char* s = readline();
        int result = sherlockAndAnagrams(s);
        fprintf(fptr, "%d\n", result);
