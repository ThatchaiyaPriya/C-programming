#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

// Maximum constraint boundaries given in problem
#define MAX_TOTAL_LEN 1000005

int main() {
    int q;
    if (scanf("%d", &q) != 1) return 0;

    // Main text editor buffer string
    char* s = (char*)malloc((MAX_TOTAL_LEN + 1) * sizeof(char));
    s[0] = '\0';
    int current_len = 0;

    // Stack to keep history snapshots of string S for undo operations
    char** history_stack = (char**)malloc((q + 1) * sizeof(char*));
    int top = -1;

    // Buffer array to parse string arguments for append operations
    char arg_str[MAX_TOTAL_LEN];

    for (int i = 0; i < q; i++) {
        int type;
        scanf("%d", &type);

        if (type == 1) { // Append
            scanf("%s", arg_str);
            int append_len = strlen(arg_str);

            // Save the exact current state before modifying S
            top++;
            history_stack[top] = (char*)malloc((current_len + 1) * sizeof(char));
            strcpy(history_stack[top], s);

            // Execute the append operation
            strcpy(s + current_len, arg_str);
            current_len += append_len;

        } else if (type == 2) { // Delete
            int k;
            scanf("%d", &k);

            // Save the exact current state before modifying S
            top++;
            history_stack[top] = (char*)malloc((current_len + 1) * sizeof(char));
            strcpy(history_stack[top], s);

            // Execute the delete operation by moving the null terminator
            current_len -= k;
            s[current_len] = '\0';

        } else if (type == 3) { // Print
            int k;
            scanf("%d", &k);
            // Print the k-th character (1-indexed base)
            printf("%c\n", s[k - 1]);

        } else if (type == 4) { // Undo
            if (top >= 0) {
                // Free old buffer memory
                free(s);
                // Revert S to pointer state popped from history stack top
                s = history_stack[top];
                current_len = strlen(s);
                top--;
            }
        }
    }

    // Clean up remaining memory structures safely
    while (top >= 0) {
        free(history_stack[top--]);
    }
    free(history_stack);
    free(s);

    return 0;
}


