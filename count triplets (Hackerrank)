#define HASH_SIZE 200003

// Simple Hash Map Node for open-addressing
typedef struct {
    long key;
    long count;
    bool occupied;
} HashNode;

// Hash function for long integers
int get_hash(long key) {
    unsigned long hash = (unsigned long)key;
    hash = (hash ^ (hash >> 16)) * 0x45d9f3b;
    hash = (hash ^ (hash >> 16)) * 0x45d9f3b;
    hash = (hash ^ (hash >> 16));
    return hash % HASH_SIZE;
}

// Find or insert key into the hash map
HashNode* hash_get(HashNode* map, long key) {
    int idx = get_hash(key);
    while (map[idx].occupied) {
        if (map[idx].key == key) {
            return &map[idx];
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    map[idx].key = key;
    map[idx].count = 0;
    map[idx].occupied = true;
    return &map[idx];
}

// Check frequency without mutating map
long hash_count(HashNode* map, long key) {
    int idx = get_hash(key);
    while (map[idx].occupied) {
        if (map[idx].key == key) {
            return map[idx].count;
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    return 0;
}

// Complete the countTriplets function below.
long countTriplets(int arr_count, long* arr, long r) {
    HashNode* left_map = (HashNode*)calloc(HASH_SIZE, sizeof(HashNode));
    HashNode* right_map = (HashNode*)calloc(HASH_SIZE, sizeof(HashNode));
    
    // Populate right map with frequencies
    for (int i = 0; i < arr_count; i++) {
        hash_get(right_map, arr[i])->count++;
    }
    
    long total_triplets = 0;
    
    // Scan middle element candidates
    for (int j = 0; j < arr_count; j++) {
        long mid = arr[j];
        
        // Remove current middle candidate from right choices
        HashNode* r_node = hash_get(right_map, mid);
        if (r_node->count > 0) r_node->count--;
        
        // Condition check for G.P.
        if (mid % r == 0) {
            long prev = mid / r;
            long next = mid * r;
            
            long left_count = hash_count(left_map, prev);
            long right_count = hash_count(right_map, next);
            
            total_triplets += left_count * right_count;
        }
        
        // Push processed middle into left choices
        hash_get(left_map, mid)->count++;
    }
    
    free(left_map);
    free(right_map);
    
    return total_triplets;
}

